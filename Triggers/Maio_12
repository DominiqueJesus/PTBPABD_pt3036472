/* Questão 01:

Ao realizar um curso o aluno ganha créditos.

Ao eliminar um curso da lista do aluno, os seus créditos totais deverão ser reduzidos.

Construa uma Trigger chamada dbo.lost_credits que atualiza o valor de créditos de um aluno após a retirada de um curso da sua lista.
*/

CREATE TRIGGER Student_PT3036472.lost_credits
ON Student_PT3036472.takes
AFTER DELETE AS
IF (ROWCOUNT_BIG() = 0)
RETURN;
BEGIN
	UPDATE Student_PT3036472.student
	SET tot_cred = tot_cred - (
		SELECT credits 
		FROM Student_PT3036472.course c
		JOIN deleted del
		ON c.course_id = del.course_id
	) WHERE student.ID = (SELECT DISTINCT ID FROM deleted) -- Perguntar: por que não é st.ID = del.ID
END;

-- Teste da trigger lost_credits --

-- Aluno selecionado: ID 30299
SELECT * FROM Student_PT3036472.takes tk WHERE tk.ID = '30299' ORDER BY tk.course_id;

-- Seção a ser deletada: 1 e 2
SELECT * FROM Student_PT3036472.section sec WHERE sec.course_id = '169';

-- Curso a ser deletado: 169 (3 pontos)
SELECT * FROM Student_PT3036472.course c WHERE c.course_id = '169' ORDER BY c.course_id;

-- Total de pontos (tot_credit)
-- Antes do trigger: 38
-- Depois do trigger: 35
SELECT * FROM Student_PT3036472.student st WHERE st.ID = '30299';

-- Processo de DELETE de curso da lista do aluno (ativa trigger lost_credits)
DELETE FROM Student_PT3036472.takes 
WHERE takes.ID = '30299'
AND takes.course_id = '169';
